{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roshd Question Package v1.0",
  "type": "object",
  "required": ["manifest", "questions"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["schema_version", "package_id", "title", "language", "book"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "package_id": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "default": "fa-IR" },
        "book": {
          "type": "object",
          "required": ["title", "grade", "edition"],
          "properties": {
            "book_code": { "type": "string" },
            "title": { "type": "string" },
            "grade": { "type": "integer", "minimum": 4, "maximum": 9 },
            "edition": { "type": "string" }
          }
        },
        "questions_file": { "type": "string", "default": "questions.json" },
        "question_count": { "type": "integer", "minimum": 0 }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "source", "difficulty", "stem", "answer"],
        "properties": {
          "external_id": { "type": "string" },
          "type": {
            "enum": [
              "single_choice", "multiple_choice", "true_false", "fill_blank",
              "short_answer", "descriptive", "numeric", "matching",
              "ordering", "multipart", "hotspot"
            ]
          },
          "chapter": { "type": "integer", "minimum": 1 },
          "lesson": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["primary_page"],
            "properties": {
              "primary_page": { "type": "integer", "minimum": 1 },
              "pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            }
          },
          "topic": { "type": "string" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "stem": { "type": "string", "minLength": 1 },
          "content_flags": {
            "type": "object",
            "properties": {
              "has_image": { "type": "boolean" },
              "is_geometric": { "type": "boolean" },
              "is_chart": { "type": "boolean" },
              "has_table": { "type": "boolean" },
              "has_formula": { "type": "boolean" }
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "role"],
              "properties": {
                "path": { "type": "string" },
                "role": { "enum": ["question_image", "option_image", "explanation_image"] },
                "alt": { "type": "string" }
              }
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" },
                "asset_path": { "type": "string" }
              }
            }
          },
          "answer": { "type": "object" },
          "explanation": { "type": "string" },
          "score": { "type": "number", "exclusiveMinimum": 0 },
          "estimated_time_seconds": { "type": "integer", "minimum": 5 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "needs_review": { "type": "boolean" },
          "review_note": { "type": "string" }
        }
      }
    }
  }
}
